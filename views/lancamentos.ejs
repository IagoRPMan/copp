<% const titulo = veTudo ? 'Conferência' : 'Meus lançamentos';
   const algumEditavel = grupos.some((g) => g.linhas.some((l) => l.editavel));
   const colunas = 7 + (podeLiberar ? 1 : 0) + (veTudo ? 1 : 0); %>
<%- include('partials/topo', { titulo }) %>
<header class="cabeca">
  <div>
    <h1><%= titulo %></h1>
    <p class="subtitulo"><%= podeLiberar
      ? 'Confira descrição e quantidade de cada lançamento e libere o que estiver certo. O mês vai para o relatório quando não restar nenhum pendente.'
      : 'Acompanhe o que você imprimiu ou lançou. A conferência e a liberação são feitas pela Contabilidade; enquanto um lançamento manual seu estiver pendente, você ainda pode corrigi-lo.' %></p>
  </div>
  <div class="linha">
    <a class="botao" href="/lancamentos/novo?voltar=<%= encodeURIComponent(voltar) %>"><svg class="icone" aria-hidden="true"><use href="#i-mais"/></svg>Lançar cópias</a>
    <a class="botao" href="/lancamentos/novo?conta=1741&voltar=<%= encodeURIComponent(voltar) %>"><svg class="icone" aria-hidden="true"><use href="#i-mais"/></svg>Lançar condução</a>
  </div>
</header>

<% if (!comps.length) { %>
  <div class="vazio">
    <p><strong>Nenhum lançamento ainda.</strong></p>
    <% if (user.podeImportar) { %><p>O mês começa com o relatório de trabalhos de impressão do PaperCut.</p><p><a class="botao primario" href="/importacoes">Importar do PaperCut</a></p>
    <% } else { %><p>Eles aparecem aqui assim que a Contabilidade importar o relatório do PaperCut.</p><% } %>
  </div>
<% } else { %>

<section class="resumo" aria-label="Resumo da competência">
  <div class="destaque"><span class="rotulo">Competência</span><strong><%= fmt.mesAno(filtros.competencia) %></strong>
    <span class="carimbo <%= compLiberada ? 'liberado' : 'pendente' %>"><%= compLiberada ? 'liberada para relatório' : 'em conferência' %></span></div>
  <div><span class="rotulo">Conferidos</span><strong class="num"><%= fmt.num(resumo.liberados) %> <small>de <%= fmt.num(resumo.liberados + resumo.pendentes) %></small></strong>
    <%- include('partials/tira', { feitos: resumo.liberados, total: resumo.liberados + resumo.pendentes }) %></div>
  <div><span class="rotulo">Aguardando conferência</span><strong class="num"><%= fmt.num(resumo.pendentes) %></strong>
    <% if (resumo.alertas) { %><a class="etiqueta alerta" href="?<%= new URLSearchParams({ competencia: filtros.competencia, status: 'pendente', alerta: '1' }) %>"><%= resumo.alertas %> com alerta de condomínio</a><% } else { %><small>Nenhum alerta</small><% } %></div>
  <div><span class="rotulo">Valor na lista</span><strong class="num"><%= fmt.brl(resumo.valor) %></strong><small>Sem os cancelados</small></div>
</section>

<form method="get" class="filtros" role="search">
  <label>Competência
    <select name="competencia" data-enviar>
      <% comps.forEach((c) => { %><option value="<%= c.competencia %>"<%= c.competencia === filtros.competencia ? ' selected' : '' %>><%= fmt.comp(c.competencia) %> (<%= fmt.periodo(c.de, c.ate) %>)</option><% }) %>
    </select></label>
  <label>Situação
    <select name="status" data-enviar>
      <% [['ativos','Pendentes e liberados'],['pendente','Só pendentes'],['liberado','Só liberados'],['cancelado','Cancelados']].forEach(([v, t]) => { %>
        <option value="<%= v %>"<%= v === filtros.status ? ' selected' : '' %>><%= t %></option><% }) %>
    </select></label>
  <label>Conta
    <select name="conta" data-enviar>
      <option value="">Cópias e condução</option>
      <option value="1732"<%= filtros.conta === '1732' ? ' selected' : '' %>>Só cópias</option>
      <option value="1741"<%= filtros.conta === '1741' ? ' selected' : '' %>>Só condução</option>
    </select></label>
  <label>Condomínio
    <select name="condominio" data-enviar>
      <option value="">Todos</option>
      <% condominios.forEach((c) => { %><option value="<%= c.id %>"<%= c.id === filtros.condominio ? ' selected' : '' %>><%= c.codigo %> · <%= c.nome %></option><% }) %>
    </select></label>
  <% if (responsaveis.length) { %>
  <label>Impresso ou lançado por
    <select name="responsavel" data-enviar>
      <option value="">Todos</option>
      <% responsaveis.forEach((u) => { %><option value="<%= u.id %>"<%= u.id === filtros.responsavel ? ' selected' : '' %>><%= u.nome %></option><% }) %>
    </select></label>
  <% } %>
  <label>Buscar <input type="search" name="q" value="<%= filtros.q %>" placeholder="Descrição, condomínio ou código"></label>
  <label class="marcar"><input type="checkbox" name="alerta" value="1"<%= filtros.alerta ? ' checked' : '' %> data-enviar> Só com alerta</label>
  <button class="botao">Filtrar</button>
</form>

<% if (cortado) { %><div class="aviso aviso-aviso">A lista mostra os primeiros <%= fmt.num(limite) %> lançamentos. Use os filtros para ver o restante.</div><% } %>

<% if (!grupos.length) { %>
  <div class="vazio"><p>Nenhum lançamento com estes filtros.</p><p><a href="/lancamentos?competencia=<%= filtros.competencia %>">Limpar filtros</a></p></div>
<% } else { %>
<datalist id="descricoes"><% descricoes.forEach((d) => { %><option value="<%= d.texto %>"><% }) %></datalist>
<form method="post" action="/lancamentos/lote" data-lote>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <input type="hidden" name="voltar" value="<%= voltar %>">
  <% if (algumEditavel || podeLiberar) { %>
  <div class="barra-lote">
    <% if (podeLiberar) { %><label class="marcar"><input type="checkbox" data-marcar-todos> Marcar todos os pendentes</label><% } %>
    <span class="nota" data-contagem aria-live="polite"></span>
    <span class="empurra"></span>
    <% if (algumEditavel) { %><button class="botao" name="acao" value="salvar">Salvar correções</button><% } %>
    <% if (podeLiberar) { %><button class="botao primario" name="acao" value="liberar" data-botao-lote><svg class="icone" aria-hidden="true"><use href="#i-visto"/></svg><span data-rotulo>Salvar e liberar marcados</span></button><% } %>
  </div>
  <% } %>
  <div class="rolagem"><table class="tabela conferencia" data-ordenar>
    <thead><tr>
      <% if (podeLiberar) { %><th class="estreita" data-sem-ordem><span class="so-leitor">Marcar</span></th><% } %>
      <th>Nº</th><th>Data</th><th>Descrição e item</th><th>Arquivos</th><th class="d">Qtde</th><th class="d">Valor</th>
      <% if (veTudo) { %><th>Por</th><% } %>
      <th>Situação</th><th data-sem-ordem><span class="so-leitor">Abrir</span></th></tr></thead>
    <% grupos.forEach((g) => { %>
    <tbody>
      <tr class="grupo"><th colspan="<%= colunas - 3 %>" scope="rowgroup"><span class="cod"><%= g.codigo %></span><%= g.nome %></th>
        <th class="d num" data-total-grupo="<%= g.valor %>"><%= fmt.brl(g.valor) %></th>
        <th colspan="<%= veTudo ? 3 : 2 %>"><% if (g.pendentes) { %><span class="nota"><%= g.pendentes %> pendente<%= g.pendentes > 1 ? 's' : '' %></span><% } %></th></tr>
      <% g.linhas.forEach((l) => { %>
      <tr class="<%= l.status %>">
        <% if (podeLiberar) { %><td class="estreita"><% if (l.status === 'pendente') { %><input type="checkbox" name="ids" value="<%= l.id %>" aria-label="Marcar lançamento <%= l.id %>"><% } %></td><% } %>
        <td class="num"><span class="linha-texto"><%= l.id %></span></td>
        <td class="num nowrap"><span class="linha-texto"><%= fmt.data(l.data) %></span></td>
        <td class="col-desc"><% if (l.editavel) { %><input name="d_<%= l.id %>" value="<%= l.descricao %>" maxlength="300" list="descricoes" data-caixa="alta" aria-label="Descrição do lançamento <%= l.id %>" required><% } else { %><span class="linha-texto"><%= l.descricao %></span><% } %>
          <span class="item-linha"><%= l.item_desc %><% if (l.conta === '1741') { %> · <%= l.func_nome || '' %><%= l.hora_inicio ? ' · ' + l.hora_inicio + (l.hora_fim ? '–' + l.hora_fim : '') : '' %><% } %><% if (l.origem === 'manual') { %> <span class="etiqueta">manual</span><% } %></span>
          <% if (l.alerta && l.status === 'pendente') { %><div class="alerta-linha"><svg class="icone" aria-hidden="true"><use href="#i-alerta"/></svg><span><%= l.alerta %></span></div><% } %>
          <% if (l.status === 'cancelado' && l.cancelado_motivo) { %><span class="quem-imprimiu">Motivo: <%= l.cancelado_motivo %></span><% } %></td>
        <td class="arquivos"<% if (l.arquivos && l.arquivos.length > 1) { %> title="<%= l.arquivos.join('\n') %>"<% } %>><% if (!l.arquivos || !l.arquivos.length) { %><span class="nota linha-texto">—</span><% } else { %>
          <% l.arquivos.slice(0, 2).forEach((a) => { %><span class="arquivo"><%= a %></span><% }) %><% if (l.arquivos.length > 2) { %><span class="nota">+ <%= l.arquivos.length - 2 %> arquivo(s)</span><% } %>
        <% } %></td>
        <td class="d num"><% if (l.editavel) { %><input name="q_<%= l.id %>" class="qtd" value="<%= l.quantidade %>" data-preco="<%= l.preco_centavos %>" inputmode="numeric" pattern="[0-9]{1,7}" aria-label="Quantidade do lançamento <%= l.id %>" required><% } else { %><span class="linha-texto"><%= fmt.num(l.quantidade) %></span><% } %></td>
        <td class="d num nowrap" data-valor="<%= l.status === 'cancelado' ? 0 : l.valor_centavos %>"><span class="linha-texto"><%= fmt.brl(l.valor_centavos) %></span></td>
        <% if (veTudo) { %><td class="col-por" title="<%= l.resp_nome || '' %>"><span class="linha-texto"><%= l.resp_nome || '—' %></span></td><% } %>
        <td><span class="carimbo <%= l.status %>"><%= l.status %></span></td>
        <td class="d nowrap"><a class="linha-texto" href="/lancamentos/<%= l.id %>?voltar=<%= encodeURIComponent(voltar) %>"><%= l.editavel ? 'Detalhes' : 'Abrir' %></a></td>
      </tr>
      <% }) %>
    </tbody>
    <% }) %>
  </table></div>
</form>
<% } %>
<% } %>
<%- include('partials/rodape') %>
