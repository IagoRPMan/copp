<%- include('partials/topo', { titulo: 'Painel do mês' }) %>
<header class="cabeca nao-imprime">
  <div>
    <h1>Painel do mês</h1>
    <p class="subtitulo">Quanto falta para fechar a competência e em quais condomínios está o trabalho de conferência.</p>
  </div>
  <% if (competencia) { %>
  <form method="get" class="linha">
    <label class="so-leitor" for="comp">Competência</label>
    <select id="comp" name="competencia" data-enviar>
      <% comps.forEach((c) => { %><option value="<%= c.competencia %>"<%= c.competencia === competencia.competencia ? ' selected' : '' %>><%= fmt.comp(c.competencia) %> (<%= fmt.periodo(c.de, c.ate) %>)<%= c.liberada ? ' · liberada' : '' %></option><% }) %>
    </select>
  </form>
  <% } %>
</header>
<% if (!competencia) { %>
  <div class="vazio">
    <p><strong>Nenhum lançamento ainda.</strong></p>
    <p>O primeiro passo é enviar o relatório de trabalhos de impressão do PaperCut.</p>
    <% if (user.podeImportar) { %><p><a class="botao primario" href="/importacoes">Importar do PaperCut</a></p><% } %>
  </div>
<% } else { %>
  <section class="resumo nao-imprime" aria-label="Resumo da competência">
    <div class="destaque"><span class="rotulo">Competência</span><strong><%= fmt.mesAno(competencia.competencia) %></strong>
      <small><%= fmt.periodo(competencia.de, competencia.ate) %></small>
      <%- include('partials/tira', { feitos: competencia.liberados, total: competencia.total }) %>
      <small><%= fmt.num(competencia.liberados) %> de <%= fmt.num(competencia.total) %> lançamentos conferidos</small></div>
    <div><span class="rotulo">Aguardando conferência</span><strong class="num"><%= fmt.num(totais.pendentes) %></strong>
      <small><%= pendentes.length %> <%= pendentes.length === 1 ? 'condomínio' : 'condomínios' %><%= maisAntigo ? ' · o mais antigo há ' + maisAntigo + (maisAntigo === 1 ? ' dia' : ' dias') : '' %></small></div>
    <div><span class="rotulo">Com alerta de condomínio</span><strong class="num"><%= fmt.num(totais.alertas) %></strong>
      <small><%= totais.manuais ? totais.manuais + ' lançamento(s) manual(is) a conferir' : 'Nenhum lançamento manual pendente' %></small></div>
    <div><span class="rotulo">Valor da competência</span><strong class="num"><%= fmt.brl(competencia.valor_total) %></strong>
      <small><%= fmt.brl(competencia.valor_liberado) %> já liberados</small></div>
  </section>

  <% if (competencia.liberada) { %>
    <div class="aviso aviso-ok nao-imprime">Competência toda conferida. <a href="/relatorios?competencia=<%= competencia.competencia %>">Abrir o relatório por condomínio</a></div>
  <% } %>

  <% if (pendentes.length) { %>
  <div class="cabeca-secao">
    <h2>Condomínios com lançamentos a conferir</h2>
    <button type="button" class="botao nao-imprime" data-imprimir>Imprimir lista</button>
  </div>
  <div class="so-impressao cabeca-pagina">
    <p class="empresa"><%= empresa %></p>
    <p><strong>Lançamentos aguardando conferência</strong> · <%= fmt.comp(competencia.competencia) %> (<%= fmt.periodo(competencia.de, competencia.ate) %>)</p>
  </div>
  <p class="nota nao-imprime">Primeiro os que esperam há mais tempo.</p>
  <div class="rolagem"><table class="tabela" data-ordenar>
    <thead><tr><th>Condomínio</th><th class="d">Pendentes</th><th class="col-tira">Andamento</th><th class="d">Valor pendente</th><th class="d">Esperando há</th><th class="nao-imprime" data-sem-ordem><span class="so-leitor">Conferir</span></th></tr></thead>
    <tbody>
    <% pendentes.forEach((c) => { %>
      <tr>
        <td><span class="cod"><%= c.codigo %></span><%= c.nome %>
          <% if (c.alertas) { %> <span class="etiqueta alerta"><%= c.alertas %> com alerta</span><% } %>
          <% if (c.manuais) { %> <span class="etiqueta"><%= c.manuais %> manual</span><% } %></td>
        <td class="d num"><%= c.pendentes %><small> de <%= c.pendentes + c.liberados %></small></td>
        <td class="col-tira"><%- include('partials/tira', { feitos: c.liberados, total: c.pendentes + c.liberados }) %></td>
        <td class="d num"><%= fmt.brl(c.valor_pendente) %></td>
        <td class="d num<%= c.dias >= 5 ? ' texto-alerta' : '' %>"><%= c.dias === 0 ? 'hoje' : c.dias + (c.dias === 1 ? ' dia' : ' dias') %></td>
        <td class="d nao-imprime"><a href="/lancamentos?competencia=<%= competencia.competencia %>&condominio=<%= c.id %>&status=pendente">Conferir</a></td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } else { %>
    <div class="vazio"><p>Nenhum lançamento pendente nesta competência.</p></div>
  <% } %>

  <% if (prontos.length) { %>
  <h2 class="nao-imprime">Já conferidos</h2>
  <div class="rolagem nao-imprime"><table class="tabela" data-ordenar>
    <thead><tr><th>Condomínio</th><th class="d">Lançamentos</th><th class="d">Valor</th><th>Última liberação</th></tr></thead>
    <tbody>
    <% prontos.forEach((c) => { %>
      <tr><td><span class="cod"><%= c.codigo %></span><%= c.nome %></td><td class="d num"><%= c.liberados %></td><td class="d num"><%= fmt.brl(c.valor) %></td><td class="num"><%= fmt.dataHora(c.ultima_liberacao) %></td></tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } %>
<% } %>
<%- include('partials/rodape') %>
