<% const pct = total ? Math.round((feitos / total) * 100) : 0; %>
<svg class="tira<%= total && feitos === total ? ' completa' : '' %>" viewBox="0 0 100 3" preserveAspectRatio="none" role="img" aria-label="<%= pct %>% liberado">
  <rect class="tira-fundo" width="100" height="3"/><rect class="tira-feito" width="<%= pct %>" height="3"/>
</svg>
