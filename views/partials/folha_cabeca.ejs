<header class="folha-cabeca">
  <% if (empresaLogo) { %><img class="folha-logo" src="/marca/logo" alt="<%= empresa %>"><% } else { %><img class="folha-logo folha-logo-copp" src="/marca/copp-icone.png" alt="COPP"><% } %>
  <div class="folha-ident">
    <p class="folha-empresa"><%= empresa %></p>
    <p class="folha-titulo"><%= conta.tituloFolha %><% if (emConferencia.length) { %> <span class="folha-previa">PRÉVIA</span><% } %></p>
    <p class="folha-periodo"><% if (!intervalo && competencia) { %><b><%= fmt.mesAno(competencia.competencia) %></b> · período de <% } else { %>Período de <% } %><%= fmt.data(de) %> a <%= fmt.data(ate) %></p>
  </div>
  <p class="folha-pag">Página<b><%= pagina %> de <%= totalPaginas %></b></p>
</header>
