<%- include('partials/topo', { titulo: 'Itens e preços' }) %>
<header class="cabeca"><h1>Itens e preços</h1></header>
<% contas.forEach((conta) => { const lista = itens.filter((i) => i.conta === conta.codigo); %>
<h2><%= conta.codigo %> · <%= conta.nome %></h2>
<p class="nota"><%= conta.codigo === '1732'
  ? 'A importação separa as páginas de cada trabalho em coloridas, dupla face e simples, e multiplica pela tabela abaixo. O custo calculado pelo PaperCut não é usado.'
  : 'Trajetos usados no lançamento de condução. "Valor específico" não tem preço de tabela: o valor é informado em cada lançamento.' %></p>
<div class="rolagem"><table class="tabela">
  <thead><tr><th>Código</th><th>Descrição</th><th>Preço (R$)</th><th>Situação</th><th>Ao mudar o preço</th><th></th></tr></thead>
  <tbody>
  <% lista.forEach((i) => { const f = 'item' + i.id; const fixo = ['simples', 'colorida', 'duplex'].includes(i.tipo); %>
    <tr>
      <td class="num"><%= fmt.cod4(i.codigo) %></td>
      <td><input form="<%= f %>" name="descricao" value="<%= i.descricao %>" maxlength="80" aria-label="Descrição do item <%= i.codigo %>" required></td>
      <td><% if (i.valor_livre) { %><span class="nota">Informado no lançamento</span><% } else { %><input form="<%= f %>" name="preco" class="curto num" inputmode="numeric" data-moeda="7" value="<%= fmt.dec(i.preco_centavos) %>" aria-label="Preço do item <%= i.codigo %>" required><% } %></td>
      <td><% if (fixo) { %>Ativo<% } else { %>
          <label class="marcar"><input form="<%= f %>" type="checkbox" name="ativo" value="1"<%= i.ativo ? ' checked' : '' %>> <%= i.tipo === 'duplex' ? 'Cobrar à parte' : 'Ativo' %></label>
          <% if (!i.ativo) { %><div class="nota"><%= i.tipo === 'duplex' ? 'Desativado: dupla face entra como cópia simples.' : 'Desativado: não aparece no lançamento. Informe o preço e ative.' %></div><% } %>
        <% } %></td>
      <td><% if (!i.valor_livre) { %><label class="marcar"><input form="<%= f %>" type="checkbox" name="aplicar" value="1"> Recalcular pendentes</label><% } %></td>
      <td class="d"><form id="<%= f %>" method="post" action="/cadastros/itens/<%= i.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="botao" name="acao" value="salvar">Salvar</button>
        <% if (i.removivel) { %> <button class="link perigoso" name="acao" value="remover" data-confirmar="Remover o item <%= fmt.cod4(i.codigo) %> · <%= i.descricao %>?">Remover</button><% } %></form></td>
    </tr>
  <% }) %>
  </tbody>
</table></div>
<% }) %>

<h2>Novo item</h2>
<form method="post" action="/cadastros/itens/novo" class="filtros">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Conta
    <select name="conta" required>
      <% contas.forEach((c) => { %><option value="<%= c.codigo %>"><%= c.codigo %> · <%= c.nome %></option><% }) %>
    </select></label>
  <label>Código <input name="codigo" inputmode="numeric" pattern="[0-9]{1,4}" maxlength="4" placeholder="Ex.: 20" required></label>
  <label>Descrição <input name="descricao" maxlength="80" placeholder="Ex.: Encadernação" required></label>
  <label>Preço (R$) <input name="preco" inputmode="numeric" data-moeda="7" placeholder="0,00"></label>
  <label class="marcar"><input type="checkbox" name="valor_livre" value="1"> Valor informado em cada lançamento</label>
  <button class="botao primario">Criar item</button>
</form>
<p class="nota">O item novo fica disponível na hora em "Lançar cópias" ou "Lançar condução", conforme a conta. A importação do PaperCut continua usando só cópias simples, coloridas e dupla face.</p>
<%- include('partials/rodape') %>
