<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Entrar · COPP</title>
<%- include('partials/fontes') %>
<link rel="stylesheet" href="/style.css?v=<%= versao %>">
</head>
<body class="entrada">
<%- include('partials/entrada_lado') %>
<main class="entrada-caixa">
  <div>
    <h1>Entrar</h1>
    <p class="entrada-sub">Use o usuário e a senha que o administrador criou para você.</p>
  </div>
  <% if (erro) { %><div class="aviso aviso-erro" role="alert"><%= erro %></div><% } %>
  <form method="post" action="/login" class="pilha">
    <label>Usuário <input name="login" value="<%= login %>" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus></label>
    <label>Senha <input name="senha" type="password" autocomplete="current-password" required></label>
    <button class="botao primario">Entrar</button>
  </form>
  <p class="nota"><a href="/recuperar">Esqueci minha senha</a> · Sem usuário? Peça ao administrador.</p>
</main>
</body>
</html>
